# 이 파일에는 이름만 있다. 값은 각자 발급해 .env.local 에 넣는다.
# .env.local 은 gitignore 되어 있고, 어떤 경로로도 저장소에 올리지 않는다.
#
# 폰에서 클라우드 세션으로 일할 때는 이 값들이 없다. 그래도 대부분의 일이
# 되는 이유와 안 되는 일은 docs/폰에서-작업하기.md 를 볼 것.

# 한국투자증권 — 시세. https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_ENV=

# DART 오픈API — 재무·사업보고서. https://opendart.fss.or.kr (무료, 하루 2만 건)
DART_API_KEY=

# Upstash Redis — 응답 캐시. 없으면 메모리 캐시로 돈다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Claude API — 마감 리포트 생성
ANTHROPIC_API_KEY=
