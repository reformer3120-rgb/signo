# SIGNO 환경변수
#
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋되지 않는다.
# 키를 하나도 넣지 않아도 야후·네이버 기반 기능은 그대로 동작한다.
#
# 키는 사람 단위로 직접 발급받는다. 남의 키를 넘겨받아 쓰지 않는다.

# --- 한국투자증권 (없으면 아래 기능만 비어 보인다) ---
#   프로그램매매 · 지수선물 · NXT 거래 · 장중 추정 투자자수급 · 미국 주간거래
#   https://apiportal.koreainvestment.com
#   주의: 모의투자(vts)는 해외주식 시세를 주지 않아 미국 주간거래가 동작하지 않는다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=vts            # vts=모의투자, prod=실전

# --- Upstash Redis (없으면 인메모리 캐시로 동작) ---
#   https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 데이터 출처 전환 (PORTING-STOCK-TAB.md 참고)
# koscom 으로 두면 종목탭이 코스콤 어댑터를 쓴다. 비워 두면 네이버+KIS.
DATA_PROVIDER=
KOSCOM_API_KEY=
KOSCOM_API_BASE=
